---
interface Props {
  status: 'Live' | 'Shipped' | 'Active' | 'Prototype' | 'Coming soon';
}
const { status } = Astro.props;
const map: Record<string, string> = {
  Live: 'bg-status-live text-white',
  Shipped: 'bg-status-shipped text-white',
  Active: 'bg-status-active text-white',
  Prototype: 'bg-status-proto text-white',
  'Coming soon': 'bg-ink/70 text-white',
};
---
<span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold tracking-wide ${map[status]}`}>
  <span class="h-1.5 w-1.5 rounded-full bg-white/90"></span>
  {status}
</span>
