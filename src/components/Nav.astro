---
import { site } from '../data/site';
---
<header class="sticky top-0 z-50 border-b border-line/70 bg-paper/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="group flex items-center gap-2 font-display text-lg font-semibold tracking-tight">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-marine transition-transform group-hover:scale-125"></span>
      {site.name}
    </a>
    <div class="hidden items-center gap-7 text-sm font-medium text-ink-soft md:flex">
      <a href="/#work" class="transition-colors hover:text-marine">Work</a>
      <a href="/#approach" class="transition-colors hover:text-marine">Approach</a>
      <a href={site.github} target="_blank" rel="noopener" class="transition-colors hover:text-marine">GitHub</a>
      <a
        href="/#contact"
        class="rounded-full bg-ink px-4 py-2 text-white transition-colors hover:bg-marine"
        >Get in touch</a
      >
    </div>
    <div class="flex items-center gap-4 text-sm font-medium md:hidden">
      <a href="/#work" class="text-ink-soft transition-colors hover:text-marine">Work</a>
      <a href="/#contact" class="rounded-full bg-ink px-4 py-2 text-white">Contact</a>
    </div>
  </nav>
</header>
